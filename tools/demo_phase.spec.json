{
  "name": "demo_fwd -- эталонное ядро самопроверки фазового профилировщика",
  "kernel": "demo_fwd",
  "sources": ["demo_phase_kernel.cu"],
  "nvdisasm": "/opt/conda/miniconda3/envs/cuda128/bin/nvdisasm",
  "out": "./build/phaseprof/demo_{tag}.cubin",
